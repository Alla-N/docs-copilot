# ── Required to run ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# ── Rate limiting (required for a public deployment) ────────────
# Unset = local dev: the limiter fails OPEN so `npm run dev` works unmetered.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salts the IP hash used to identify callers (never the raw IP). REQUIRED whenever the
# Upstash keys are set — the route refuses to start without it (a public constant would
# make the hash a lookup table over the IPv4 space). Any long random string.
IP_HASH_SALT=

# ── Assistant turn signing (required for a public deployment) ───
# HMAC key for the assistant turns the client sends back as history. Unset in a DEPLOYMENT and
# the app refuses to start: unsigned history means a forged assistant turn reaches the model
# (lib/assistant-signature.ts). Local dev falls back to a constant. Any long random string.
ASSISTANT_SIGNING_SECRET=

# ── Optional tuning (defaults shown) ────────────────────────────
# RATE_BURST_PER_MIN=10
# RATE_DAILY_PER_IP=50
# RATE_DAILY_GLOBAL=200      # ≈ €0.80/day worst case with a production Cohere key (see lib/rate-limit.ts)
# VECTOR_CANDIDATES=100
# RERANK_TOP_N=5
# PLANNER_MODEL=gpt-4o-mini
# GENERATION_MODEL=gpt-4o-mini
# MAX_OUTPUT_TOKENS=1024       # answer cap; the planner is capped at 512 in code
# JUDGE_MODEL=gpt-4o-mini
# RERANK_INTERVAL_MS=250     # pause between eval cases. Trial Cohere key (10 calls/min)? use 6500.
