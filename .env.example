# ── Required to run ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
# Python agent service (agent/) only. psycopg connects to Postgres directly, not through the
# Supabase REST API, so it needs a connection string. Use the SESSION POOLER one (Supabase:
# Connect > Direct > Session pooler; host ends in pooler.supabase.com, port 5432). The direct
# db.<ref>.supabase.co host is IPv6-only and fails from Docker and AWS; settings.py rejects it.
DATABASE_URL=
# Registers the agent service's POST /search debug route, which spends embed + rerank credits.
# Local only (invariant 2): never set it in a deployment. Without it the route does not exist.
# ENABLE_SEARCH_ENDPOINT=1
# The key the Next.js route sends the agent service as "Authorization: Bearer <key>". Every
# paid route (POST /chat, POST /search) requires it, and the service refuses to start without
# it. At least 32 characters: openssl rand -hex 32. The agent service ALSO needs
# ASSISTANT_SIGNING_SECRET below (the same value as the Next.js app): it signs the answers.
AGENT_API_KEY=
# Where the Next.js route forwards chat requests (step 2.6), e.g. http://127.0.0.1:8000 for a
# local `uvicorn`. Unset = the route answers by itself with the TypeScript pipeline, which is the
# default everywhere: setting it is the switch, and unsetting it is the rollback. With it set the
# route also needs AGENT_API_KEY, and the agent service writes the query_log rows (db/006 first).
# AGENT_URL=
# Langfuse tracing for the agent service (step 2.7). BOTH keys or nothing: unset, the service
# traces nothing and behaves exactly as it did before. Free Hobby project at cloud.langfuse.com;
# LANGFUSE_BASE_URL follows the region (EU, US, ...). LANGFUSE_ENVIRONMENT separates deployments
# in the dashboard (development, ci, production); it may not start with the word langfuse.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development
# When the agent service saves a /chat run's conversation state: sync, async or exit
# (agent/src/copilot_agent/settings.py says what each costs, as measured). Optional.
# CHECKPOINT_DURABILITY=exit

# ── Rate limiting (required for a public deployment) ────────────
# Unset = local dev: the limiter fails OPEN so `npm run dev` works unmetered.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salts the IP hash used to identify callers (never the raw IP). REQUIRED whenever the
# Upstash keys are set — the route refuses to start without it (a public constant would
# make the hash a lookup table over the IPv4 space). Any long random string.
IP_HASH_SALT=

# ── Assistant turn signing (required for a public deployment) ───
# HMAC key for the assistant turns the client sends back as history. Unset in a DEPLOYMENT and
# the app refuses to start: unsigned history means a forged assistant turn reaches the model
# (lib/assistant-signature.ts). Local dev falls back to a constant. Any long random string.
# The Python agent service signs with it too (agent/src/copilot_agent/signing.py) and refuses to
# start without it, locally as well: set it here once and both sides use it.
ASSISTANT_SIGNING_SECRET=

# ── Optional tuning (defaults shown) ────────────────────────────
# RATE_BURST_PER_MIN=10
# RATE_DAILY_PER_IP=50
# RATE_DAILY_GLOBAL=200      # ≈ €0.80/day worst case with a production Cohere key (see lib/rate-limit.ts)
# VECTOR_CANDIDATES=100
# RERANK_TOP_N=5
# PLANNER_MODEL=gpt-4o-mini
# GENERATION_MODEL=gpt-4o-mini
# MAX_OUTPUT_TOKENS=1024       # answer cap; the planner is capped at 512 in code
# JUDGE_MODEL=gpt-4o-mini
# RERANK_INTERVAL_MS=250     # pause between eval cases. Trial Cohere key (10 calls/min)? use 6500.
